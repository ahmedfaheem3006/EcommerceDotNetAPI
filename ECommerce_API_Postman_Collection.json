	"info": {
		"_postman_id": "e3831b86-d98c-4f7f-a186-b4d6a4dbbb45",
		"name": "E-Commerce API (.NET 9 + Scalar)",
		"description": "Postman collection to test the .NET 9 E-Commerce API system.\n\n### Authentication\n- Register a user using `POST /api/auth/register`.\n- Login using `POST /api/auth/login`. This will automatically save the token in the `jwt_token` collection variable via a post-response script.\n\n### Authorization\n- To perform Admin actions, promote the registered user to the Admin role in the database first. Then log in again to refresh the token claims.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
